# Root-level compose secrets — copy to .env (gitignored) and fill in
# a real value before running `docker compose up`. This is separate
# from backend-fastapi/.env, which holds the backend app's own config
# (DATABASE_URL, SECRET_KEY, SMTP, etc.) — its DATABASE_URL password
# must match POSTGRES_PASSWORD below exactly, since docker-compose.yml
# passes this one to the postgres container while the backend connects
# using whatever password its own .env's DATABASE_URL contains.
POSTGRES_PASSWORD=changeme
